# Copy to .env (git-ignored) and fill in. Read by `docker compose` for the production stack,
# so keep the real .env on the server only: every `docker compose` command reads it, and on a
# dev machine it would change the development database's credentials.
#
# Not listed here because Compose fixes them for the app: DJANGO_DEBUG (always false),
# POSTGRES_HOST (the db service) and POSTGRES_PORT.
#
# The app refuses to start if the secret key or database password is empty, still
# "change-me", or (for the password) the development default "logbook".

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Required: the tailnet name the app is served at, and the same as an https origin.
DJANGO_ALLOWED_HOSTS=logbook.your-tailnet.ts.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://logbook.your-tailnet.ts.net

# Database credentials, shared by the app and Postgres. Set a real password BEFORE the first
# `docker compose up`: Postgres ignores a changed password on an existing volume.
POSTGRES_DB=logbook
POSTGRES_USER=logbook
POSTGRES_PASSWORD=change-me
