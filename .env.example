# Copy to .env (git-ignored) and fill in. Read by `docker compose` for the production stack.

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Required: the tailnet name the app is served at, and the same as an https origin.
DJANGO_ALLOWED_HOSTS=logbook.your-tailnet.ts.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://logbook.your-tailnet.ts.net

# Database credentials, shared by the app and Postgres. Change the password.
POSTGRES_DB=logbook
POSTGRES_USER=logbook
POSTGRES_PASSWORD=change-me
